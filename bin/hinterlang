#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -f "$root/_build/hinterlang_backend.beam" ] || [ ! -f "$root/_build/hinterlang_records.beam" ]; then
    echo 'Hinterlang: run make in the repository first' >&2
    exit 1
fi
exec erl +S 2:2 -noshell -pa "$root/_build" -s hinterlang_backend main
